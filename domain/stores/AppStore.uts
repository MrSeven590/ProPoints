import type { Person } from '../models/person.uts'

/**
 * 人员新增事件 Payload
 * 使用强类型 Person 替代 UTSJSONObject
 */
export type PersonAddedEventPayload = {
  person: Person
}

/**
 * 人员更新字段（允许更新的字段子集）
 */
export type PersonUpdateFields = {
  name?: string
  name_pinyin_full?: string
  name_pinyin_initials?: string
  team_id?: number | null
  is_active?: number
}

/**
 * 人员更新事件 Payload
 * 使用显式 patch 类型替代开放 UTSJSONObject
 */
export type PersonUpdatedEventPayload = {
  personId: number
  updates: PersonUpdateFields
}

/**
 * 轮次变更事件 Payload
 * 最小通知型：只传轮次ID和变更时间，不传递完整配置
 */
export type RoundChangedEventPayload = {
  roundId: number | null
  changedAt: number
}

// ============================================
// 班次配置
// ============================================

/**
 * 获取当前班次号
 * @returns 班次号（默认1）
 */
export function getCurrentClassNo(): number {
  const config = loadClassConfig()
  if (config != null) {
    const classNo = config['classNo'] as number | null
    if (classNo != null && classNo > 0) {
      return classNo
    }
  }
  return 1 // 默认返回1班
}

/**
 * 设置当前班次号
 * @param classNo 班次号（正整数）
 */
export function setCurrentClassNo(classNo: number): void {
  saveClassConfig({ classNo: classNo } as UTSJSONObject)
}

