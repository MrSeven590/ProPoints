/**
 * 获取指定日期和环节的会话（公开强类型版本）
 * @param date 日期
 * @param stageCode 环节代码
 * @returns 会话数组
 */
export function getSessionsByDateAndStage(date: string, stageCode: string): SessionData[] {
  const raws = getSessionsByDateAndStageFromRepo(date, stageCode)
  const result: SessionData[] = []
  for (let i = 0; i < raws.length; i++) {
    result.push(storageJsonToSessionData(raws[i]))
  }
  return result
}

/**
 * 获取某轮次的所有已提交会话
 * @param roundId 轮次ID
 * @returns SessionData[] 会话数据数组
 */
export function getSessionsByRoundId(roundId: number): SessionData[] {
  const allSessions: SessionData[] = []

  // 获取最近180天的所有会话
  const today = new Date()
  for (let i = 0; i < MAX_ROUND_QUERY_DAYS; i++) {
    const date = new Date(today.getTime() - i * 24 * 60 * 60 * 1000)
    const dateStr = date.toISOString().split('T')[0]
    const sessions = getSessionsByDate(dateStr)

    for (let j = 0; j < sessions.length; j++) {
      const session = sessions[j]
      // 只收集已提交且匹配轮次的会话
      if (session.status == 'submitted' && session.round_id == roundId) {
        allSessions.push(session)
      }
    }
  }

  return allSessions
}

/**
 * 将 SessionData[] 转换为存储格式 JSON[]（供导出服务内部使用）
 * @param sessions 会话数据数组
 * @returns 存储格式 JSON 数组
 */
function toSessionStorageJsonList(sessions: SessionData[]): UTSJSONObject[] {
  const result: UTSJSONObject[] = []
  for (let i = 0; i < sessions.length; i++) {
    result.push(sessionDataToStorageJson(sessions[i]))
  }
  return result
}

