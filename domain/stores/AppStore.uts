  savePersonsToRepo(persons)
}

/**
 * 将 UTSJSONObject 安全转换为 Person 类型
 * 轻量转换：提取关键字段，确保类型安全
 * @param raw 原始 JSON 对象
 * @returns Person 对象
 */
function toPerson(raw: UTSJSONObject): Person {
  return {
    id: raw['id'] as number,
    uuid: raw['uuid'] as string,
    name: raw['name'] as string,
    name_pinyin_full: raw['name_pinyin_full'] as string,
    name_pinyin_initials: raw['name_pinyin_initials'] as string,
    team_id: raw['team_id'] as number | null,
    is_active: raw['is_active'] as number,
    created_at: raw['created_at'] as number,
    updated_at: raw['updated_at'] as number,
    version: raw['version'] as number,
    sync_status: raw['sync_status'] as string
  } as Person
}

/**
 * 添加人员
 * @param person 人员数据
 */
export function addPerson(person: UTSJSONObject): void {
  const persons = loadPersons()
  persons.push(person)
  savePersons(persons)
  // 使用轻量转换函数确保类型安全
  const personTyped = toPerson(person)
  uni.$emit(EVENT_PERSON_ADDED, { person: personTyped } as PersonAddedEventPayload)
}

/**
 * 更新人员
 * @param personId 人员ID
 * @param updates 更新数据
 */
export function updatePerson(personId: number, updates: UTSJSONObject): void {
  const persons = loadPersons()
  for (let i = 0; i < persons.length; i++) {
    const p = persons[i]
    if (p['id'] == personId) {
      // 合并更新
      const keys = Object.keys(updates)
      for (let j = 0; j < keys.length; j++) {
        const key = keys[j]
        p[key] = updates[key]
      }
      break
    }
  }
  savePersons(persons)
  // 构建显式 patch 类型后发送事件
  const updateFields: PersonUpdateFields = {
    name: updates['name'] as string | undefined,
    name_pinyin_full: updates['name_pinyin_full'] as string | undefined,
    name_pinyin_initials: updates['name_pinyin_initials'] as string | undefined,
    team_id: updates['team_id'] as number | null | undefined,
    is_active: updates['is_active'] as number | undefined
  }
  uni.$emit(EVENT_PERSON_UPDATED, { personId, updates: updateFields } as PersonUpdatedEventPayload)
}

/**
 * 根据ID查找人员
 * @param personId 人员ID
 * @returns 人员数据，不存在返回null
 */
export function findPersonById(personId: number): UTSJSONObject | null {
  const persons = loadPersons()
  for (let i = 0; i < persons.length; i++) {
    const p = persons[i]
    if (p['id'] == personId) {
      return p
    }
  }
  return null
}

