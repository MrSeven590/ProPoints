// ============================================
// 数据传输中心
// ============================================

/**
 * 轮次选项类型
 */
export type TransferRoundOption = {
  id: number
  label: string
}

/**
 * 获取当前班次的传输轮次列表
 * @returns 轮次选项数组（已过滤、排序、带标签）
 */
export function listTransferRoundsForCurrentClass(): TransferRoundOption[] {
  const classNo = getCurrentClassNo()
  const allRounds = loadRounds()
  const classRounds: UTSJSONObject[] = []

  // 过滤当前班次的轮次
  for (let i = 0; i < allRounds.length; i++) {
    const round = allRounds[i]
    const roundClassNo = round['class_no'] as number
    if (roundClassNo == classNo) {
      classRounds.push(round)
    }
  }

  // 按 ID 降序排序（最新的在前）
  classRounds.sort((a: UTSJSONObject, b: UTSJSONObject): number => {
    const aId = a['id'] as number
    const bId = b['id'] as number
    return bId - aId
  })

  // 生成选项列表
  const options: TransferRoundOption[] = []
  for (let i = 0; i < classRounds.length; i++) {
    const round = classRounds[i]
    const id = round['id'] as number
    const year = round['year'] as number
    const roundNo = round['round_no'] as number
    // Null 安全处理：本地轮次只读取 micro_enabled
    const microValue = round['micro_enabled']
    const micro = microValue != null ? microValue as number : 0

    const label = `${year}年 第${roundNo}轮 (微调${micro})`
    options.push({ id: id, label: label } as TransferRoundOption)
  }

  return options
}

/**
 * 导出工分明细（CSV 格式）
 * @param roundId 轮次ID
 * @param stageCode 工序代码（可选，为空则导出全部工序）
 * @returns CSV 格式字符串（日期,姓名,工分），存储值÷10转小数值，无数据时返回 null
 */
export function exportSessionCSV(roundId: number, stageCode: string | null = null): string | null {
  const sessions = getSessionsByRoundId(roundId)

  // CSV 表头
  const lines: string[] = []
  lines.push('\uFEFF日期,姓名,原始工分,扣分,扣分原因,实发工分') // BOM + 表头（Excel 兼容中文）

  let hasData = false

  for (let i = 0; i < sessions.length; i++) {
    const session = sessions[i]
    // 只处理已提交会话
    if (session.status != 'submitted') {
      continue
    }
    const date = session.session_date
    // 工序过滤
    if (stageCode != null && session.stage_code != stageCode) {
      continue
    }

    // 日期格式化 yyyy/M/D
    const dateParts = date.split('-')
    const dateFormatted = `${dateParts[0]}/${parseInt(dateParts[1])}/${parseInt(dateParts[2])}`

    // 遍历所有仓的工人
    for (let j = 0; j < session.bins.length; j++) {
      const bin = session.bins[j]
      for (let k = 0; k < bin.workers.length; k++) {
        const worker = bin.workers[k]
        const personName = worker.person_name
        const pointsUnits = worker.points_units
        const deductedUnits = worker.deducted_units
        const penaltyReason = worker.penalty_reason
        // 最终工分 = 原始 - 扣分（存储值为×10单位，导出时÷10转小数）
        const finalUnits = pointsUnits - deductedUnits
        if (finalUnits > 0) {
          const displayPoints = (pointsUnits / 10).toFixed(1)
          const displayDeducted = (deductedUnits / 10).toFixed(1)
          const displayFinal = (finalUnits / 10).toFixed(1)
          lines.push(`${dateFormatted},${personName},${displayPoints},${displayDeducted},${penaltyReason},${displayFinal}`)
          hasData = true
        }
      }
    }

    // 跨仓人员（存储值为×10单位，导出时÷10转小数）
    const crossBin = session.cross_bin
    if (crossBin != null && crossBin.enabled == true) {
      const personName = crossBin.person_name
      const pointsUnits = crossBin.points_units
      if (pointsUnits > 0 && personName != '') {
        const deductedUnits = crossBin.deducted_units
        const penaltyReason = crossBin.penalty_reason
        const finalUnits = pointsUnits - deductedUnits
        const displayPoints = (pointsUnits / 10).toFixed(1)
        const displayDeducted = (deductedUnits / 10).toFixed(1)
        const displayFinal = (finalUnits / 10).toFixed(1)
        lines.push(`${dateFormatted},${personName},${displayPoints},${displayDeducted},${penaltyReason},${displayFinal}`)
        hasData = true
      }
    }

    // 晾堂人员（属于安曲工序 AN_QU，仅在未指定工序或指定安曲工序时导出）
    if (stageCode == null || stageCode == 'AN_QU') {
      const liangTang = session.liang_tang
      if (liangTang != null) {
        const roleCodes: string[] = ['WHEAT_MATERIAL', 'MACHINE_GUARD', 'KOJI_UNLOADER', 'MICRO_OPERATOR']
        for (let r = 0; r < roleCodes.length; r++) {
          const roleCode = roleCodes[r]
          let roleWorkers: SessionWorkerStorageData[] | null = null
          if (roleCode == 'WHEAT_MATERIAL') {
            roleWorkers = liangTang.WHEAT_MATERIAL
          } else if (roleCode == 'MACHINE_GUARD') {
            roleWorkers = liangTang.MACHINE_GUARD
          } else if (roleCode == 'KOJI_UNLOADER') {
            roleWorkers = liangTang.KOJI_UNLOADER
          } else if (roleCode == 'MICRO_OPERATOR') {
            roleWorkers = liangTang.MICRO_OPERATOR
          }
          if (roleWorkers != null) {
            for (let k = 0; k < roleWorkers.length; k++) {
              const worker = roleWorkers[k]
              const personName = worker.person_name
              if (personName != '') {
                const pointsUnits = worker.points_units
                const deductedUnits = worker.deducted_units
                const penaltyReason = worker.penalty_reason
                const finalUnits = pointsUnits - deductedUnits
                const displayPoints = (pointsUnits / 10).toFixed(1)
                const displayDeducted = (deductedUnits / 10).toFixed(1)
                const displayFinal = (finalUnits / 10).toFixed(1)
                lines.push(`${dateFormatted},${personName},${displayPoints},${displayDeducted},${penaltyReason},${displayFinal}`)
                hasData = true
              }
            }
          }
        }
      }
    }

    // 堆曲人员（属于拆曲工序 CHAI_QU，仅在未指定工序或指定拆曲工序时导出）
    if (stageCode == null || stageCode == 'CHAI_QU') {
      const duiQu = session.dui_qu
      if (duiQu != null) {
        for (let k = 0; k < duiQu.workers.length; k++) {
          const worker = duiQu.workers[k]
          const personName = worker.person_name
          if (personName != '') {
            const pointsUnits = worker.points_units
            const deductedUnits = worker.deducted_units
            const penaltyReason = worker.penalty_reason
            const finalUnits = pointsUnits - deductedUnits
            const displayPoints = (pointsUnits / 10).toFixed(1)
            const displayDeducted = (deductedUnits / 10).toFixed(1)
            const displayFinal = (finalUnits / 10).toFixed(1)
            lines.push(`${dateFormatted},${personName},${displayPoints},${displayDeducted},${penaltyReason},${displayFinal}`)
            hasData = true
          }
        }
      }
    }
  }

  if (hasData == false) {
    return null
  }
  return lines.join('\n')
}

/**
 * 导出安曲数据（PPX1 格式）
 * @param roundId 轮次ID
 * @returns PPX1 格式字符串，如果轮次不存在返回 null
 */
export function exportAnQuData(roundId: number): string | null {
  const classNo = getCurrentClassNo()
  const allRounds = loadRounds()
  const floorConfig = loadBinSeqMaxByFloor()
  const allBins = loadBins()
  const allSessions = toSessionStorageJsonList(getSessionsByRoundId(roundId))

  const payload = collectAnQuPayload(roundId, classNo, allRounds, floorConfig, allBins, allSessions)
  if (payload == null) {
    return null
  }
  return seal(payload)
}

/**
 * 导出配置数据（PPX1 格式）
 * @param includePersons 是否包含人员数据
 * @param includeCoef 是否包含系数数据
 * @returns PPX1 格式字符串
 */
export function exportConfigData(
  includePersons: boolean = true,
  includeCoef: boolean = true
): string {
  const classNo = getCurrentClassNo()
  const allPersons = includePersons ? loadPersons() : null
  const activeCoefSet = includeCoef ? loadActiveCoefSet() : null

  const payload = assembleConfigPayload(classNo, allPersons, activeCoefSet, includePersons, includeCoef)
  return seal(payload)
}


/**
 * 预览传输导入
 * @param envelope PPX1 格式字符串
 * @returns 导入预览结果
 */
export function previewTransferImport(envelope: string): ImportPreview {
  const unsealResult = unseal(envelope)

  if (!unsealResult.success) {
    return {
      success: false,
      error: unsealResult.error,
      payload: null,
      payloadKind: null,
      matchStatus: null,
      resolvedRoundId: null,
      candidates: null,
      warnings: [],
      conflictSummary: null,
      requiresConfirmation: false,
      canImport: false
    }
  }

  const payload = unsealResult.payload
  if (payload == null) {
    return {
      success: false,
      error: {
        code: 'INVALID_PAYLOAD',
        message: '载荷为空',
        details: null
      },
      payload: null,
      payloadKind: null,
      matchStatus: null,
      resolvedRoundId: null,
      candidates: null,
      warnings: [],
      conflictSummary: null,
      requiresConfirmation: false,
      canImport: false
    }
  }

  const currentClassNo = getCurrentClassNo()
  const payloadClassNo = extractPayloadClassNo(payload)
  const classError = validateClassMatch(payloadClassNo, currentClassNo)

  // TransferService.unseal 已返回 payloadKind；typed payload 不能反向强转为 UTSJSONObject
  const payloadKind = unsealResult.payloadKind

  if (classError != null) {
    return {
      success: false,
      error: classError,
      payload: payload,
      payloadKind: payloadKind,
      matchStatus: null,
      resolvedRoundId: null,
      candidates: null,
      warnings: [],
      conflictSummary: null,
      requiresConfirmation: false,
      canImport: false
    }
  }

  const warnings: ImportWarning[] = []
  let matchStatus: RoundResolveStatus | null = null
  let resolvedRoundId: number | null = null
  let candidates: RoundCandidate[] | null = null

  if (payloadKind == 'ANQ') {
    const anquPayload = payload as AnQuPayload
    const allRounds = loadRounds()
    const roundResult = resolveRound(anquPayload, allRounds)

    matchStatus = roundResult.status
    resolvedRoundId = roundResult.roundId
    // 直接赋值，类型已匹配
    candidates = roundResult.candidates

    if (roundResult.status == 'SOFT_MATCH') {
      warnings.push({
        code: 'ROUND_SOFT_MATCH',
        message: '轮次 micro 版本不完全匹配',
        details: roundResult.warnings != null && roundResult.warnings.length > 0 ? roundResult.warnings[0] : null
      })
    } else if (roundResult.status == 'AMBIGUOUS') {
      resolvedRoundId = null
    } else if (roundResult.status == 'NOT_FOUND') {
      return {
        success: false,
        error: {
          code: 'ROUND_REQUIRED',
          message: '未找到匹配的轮次',
          details: '请先创建对应的轮次记录'
        },
        payload: null,
        payloadKind: null,
        matchStatus: roundResult.status,
        resolvedRoundId: null,
        candidates: null,
        warnings: [],
        conflictSummary: null,
        requiresConfirmation: false,
        canImport: false
      }
    }
  }

  const localFloorConfig = loadBinSeqMaxByFloor()
  const localPersons = loadPersons()
  const activeCoefSet = loadActiveCoefSet()

  const conflictSummary = detectImportConflicts(payload, localFloorConfig, localPersons, activeCoefSet)

  // 如果能执行到这里，说明前面没有遇到阻塞性错误（有错误会提前返回）
  const hasWarnings = warnings.length > 0
  const hasConflicts = conflictSummary != null && conflictSummary.hasConflict

  // canImport 逻辑：轮次匹配成功（ANQ）
  let canImport = false
  if (payloadKind == 'CONFIG') {
    // CONFIG 类型：即使有冲突也可导入（用户确认后覆盖）
    canImport = true
  } else if (payloadKind == 'ANQ') {
    // ANQ 类型：需要轮次匹配成功
    if (matchStatus == 'EXACT_MATCH' || matchStatus == 'SOFT_MATCH') {
      canImport = resolvedRoundId != null
    }
  }

  // requiresConfirmation 逻辑：区分警告和冲突的确认级别
  // - 冲突必须确认（将覆盖本地配置）
  // - 警告需要确认（如轮次 micro 差异）
  const requiresConfirmation = hasConflicts || hasWarnings

  return {
    success: true,
    error: null,
    payload: payload,
    payloadKind: payloadKind,
    matchStatus: matchStatus,
    resolvedRoundId: resolvedRoundId,
    candidates: candidates,
    warnings: warnings,
    conflictSummary: conflictSummary,
    requiresConfirmation: requiresConfirmation,
    canImport: canImport
  }
}

/**
 * 应用传输导入（统一入口）
 */
export function applyTransferImport(
  payload: TransferPayload,
  payloadKind: PayloadKind,
  resolvedRoundId: number | null,
  applyFloorConfig: boolean = true
): ImportResult {
  // TransferPayload 是 typed payload，禁止反向强转 UTSJSONObject；由 preview 传入 kind
  const kind = payloadKind

  if (kind == 'ANQ') {
    if (resolvedRoundId == null || resolvedRoundId <= 0) {
      return {
        success: false,
        payloadKind: 'ANQ',
        roundId: null,
        binsImported: 0,
        binsSkipped: 0,
        personsImported: 0,
        coefUpdated: false,
        floorConfigApplied: false,
        snapshotSaved: false,
        warnings: [],
        errors: ['请选择目标轮次']
      }
    }
    return applyAnQuImportInStore(payload as AnQuPayload, resolvedRoundId, applyFloorConfig)
  } else if (kind == 'CONFIG') {
    return applyConfigImportInStore(payload as ConfigPayload)
  }

  return {
    success: false,
    payloadKind: kind,
    roundId: null,
    binsImported: 0,
    binsSkipped: 0,
    personsImported: 0,
    coefUpdated: false,
    floorConfigApplied: false,
    snapshotSaved: false,
    warnings: [],
    errors: ['未知的载荷类型']
  }
}

function applyAnQuImportInStore(payload: AnQuPayload, resolvedRoundId: number, applyFloorConfig: boolean): ImportResult {
  const errors: string[] = []
  const warnings: string[] = []

  const snapshotItems = buildAnQuSnapshotItems(payload.bins)
  const classNo = payload.c

  try {
    saveAnQuImportSnapshot(classNo, resolvedRoundId, { items: snapshotItems } as UTSJSONObject)
  } catch (e: Error) {
    errors.push(`保存快照失败: ${e.message}`)
    return {
      success: false,
      payloadKind: 'ANQ',
      roundId: resolvedRoundId,
      binsImported: 0,
      binsSkipped: payload.skip.length,
      personsImported: 0,
      coefUpdated: false,
      floorConfigApplied: false,
      snapshotSaved: false,
      warnings: warnings,
      errors: errors
    }
  }

  if (applyFloorConfig) {
    const floorConfig = convertFloorPairsToConfig(payload.f)
    saveBinSeqMaxByFloor(floorConfig)
  }

  return {
    success: true,
    payloadKind: 'ANQ',
    roundId: resolvedRoundId,
    binsImported: payload.bins.length,
    binsSkipped: payload.skip.length,
    personsImported: 0,
    coefUpdated: false,
    floorConfigApplied: applyFloorConfig,
    snapshotSaved: true,
    warnings: warnings,
    errors: errors
  }
}

function applyConfigImportInStore(payload: ConfigPayload): ImportResult {
  const errors: string[] = []
  const warnings: string[] = []
  let personsImported = 0
  let coefUpdated = false
  let activeSetIdToSave: number | null = null
  let updatedCoefSetToSave: UTSJSONObject | null = null

  if (payload.coef != null) {
    const activeSetId = loadActiveCoefSetIdFromRepo()
    if (activeSetId == null) {
      errors.push('当前激活系数版本不存在')
      return {
        success: false,
        payloadKind: 'CONFIG',
        roundId: null,
        binsImported: 0,
        binsSkipped: 0,
        personsImported: 0,
        coefUpdated: false,
        floorConfigApplied: false,
        snapshotSaved: false,
        warnings: warnings,
        errors: errors
      }
    }

    const currentCoefSet = loadCoefSetFromRepo(activeSetId)
    const updatedCoefSet = mergeImportedCoefIntoActiveSet(payload.coef, currentCoefSet)

    if (updatedCoefSet == null) {
      errors.push('合并系数失败')
      return {
        success: false,
        payloadKind: 'CONFIG',
        roundId: null,
        binsImported: 0,
        binsSkipped: 0,
        personsImported: 0,
        coefUpdated: false,
        floorConfigApplied: false,
        snapshotSaved: false,
        warnings: warnings,
        errors: errors
      }
    }

    activeSetIdToSave = activeSetId
    updatedCoefSetToSave = updatedCoefSet
  }

  if (payload.persons != null) {
    const storagePersons = fromTransferPersonData(payload.persons)
    savePersonsToRepo(storagePersons)
    personsImported = payload.persons.length
  }

  if (updatedCoefSetToSave != null && activeSetIdToSave != null) {
    saveCoefSetToRepo(activeSetIdToSave, updatedCoefSetToSave)
    coefUpdated = true
  }

  if (payload.persons != null || payload.coef != null) {
    const classNo = getCurrentClassNo()
    saveLiangTangDefaultToRepo(classNo, {} as UTSJSONObject)
    saveDuiQuDefaultToRepo(classNo, [])
  }

  if (payload.persons == null && payload.coef == null) {
    warnings.push('CONFIG 包未包含任何可导入配置')
  }

  return {
    success: true,
    payloadKind: 'CONFIG',
    roundId: null,
    binsImported: 0,
    binsSkipped: 0,
    personsImported: personsImported,
    coefUpdated: coefUpdated,
    floorConfigApplied: false,
    snapshotSaved: false,
    warnings: warnings,
    errors: errors
  }
}
