 * 获取指定日期的所有会话（内部弱类型版本）
 * @param date 日期
 * @returns 会话数组
 */
function getSessionsByDateRaw(date: string): SessionStorageJson[] {
  return getSessionsByDateFromRepo(date)
}

/**
 * 获取指定日期的所有会话（公开强类型版本）
 * @param date 日期
 * @returns 会话数组
 */
export function getSessionsByDate(date: string): SessionData[] {
  const raws = getSessionsByDateFromRepo(date)
  const result: SessionData[] = []
  for (let i = 0; i < raws.length; i++) {
    result.push(storageJsonToSessionData(raws[i]))
  }
  return result
}

