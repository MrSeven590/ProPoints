/**
 * 保存草稿会话（内部弱类型版本）
 * @param sessionDate 会话日期
 * @param stageCode 环节代码
 * @param roundId 轮次ID
 * @param sessionData 会话数据
 */
function saveDraftSessionRaw(sessionDate: string, stageCode: string, roundId: number | null, sessionData: SessionStorageJson): void {
  saveDraftSessionToRepo(sessionDate, stageCode, roundId, sessionData)
  uni.$emit(EVENT_SESSION_SAVED, { sessionDate, stageCode, roundId } as SessionEventPayload)
}

/**
 * 保存草稿会话（公开强类型版本）
 * @param sessionDate 会话日期
 * @param stageCode 环节代码
 * @param sessionData 会话数据
 */
export function saveDraftSession(sessionDate: string, stageCode: string, roundId: number | null, sessionData: SessionData): void {
  saveDraftSessionToRepo(sessionDate, stageCode, roundId, sessionDataToStorageJson(sessionData))
  uni.$emit(EVENT_SESSION_SAVED, { sessionDate: sessionData.session_date, stageCode, roundId } as SessionEventPayload)
}

