// ============================================
// 常量定义
// ============================================

const PAYLOAD_KIND_ANQ = 'ANQ'
const PAYLOAD_KIND_CONFIG = 'CONFIG'
const PAYLOAD_KIND_BUNDLE = 'BUNDLE'
const SESSION_STATUS_SUBMITTED = 'submitted'
export const MAX_ROUND_QUERY_DAYS = 180

// ============================================
// Phase 3: 数据收集层（导出侧）
// ============================================

/**
 * 收集指定轮次的安曲数据载荷
 * @param roundId 轮次ID
 * @param classNo 当前班次号
 * @param allRounds 所有轮次数据
 * @param floorConfig 楼层配置（从持久化存储读取）
 * @param allBins 所有曲块数据
 * @param allSessions 所有会话数据
 * @returns AnQu载荷，如果轮次不存在返回null
 */
export function collectAnQuPayload(
  roundId: number,
  classNo: number,
  allRounds: UTSJSONObject[],
  floorConfig: UTSJSONObject | null,
  allBins: UTSJSONObject[],
  allSessions: UTSJSONObject[]
): AnQuPayload | null {
  // 查找轮次信息
  let roundInfo: UTSJSONObject | null = null
  for (let i = 0; i < allRounds.length; i++) {
    const id = allRounds[i]['id'] as number
    if (id == roundId) {
      roundInfo = allRounds[i]
      break
    }
  }

  if (roundInfo == null) {
    return null
  }

  const year = roundInfo['year'] as number
  const roundNo = roundInfo['round_no'] as number
  // 传输字段 m 对应本地 FermentRound.micro_enabled
  const microEnabledValue = roundInfo['micro_enabled']
  const micro = microEnabledValue != null ? microEnabledValue as number : 0

  // 使用传入的楼层配置
  const floors = convertFloorConfigToPairs(floorConfig)

  // 建立 bin 索引 Map: "classNo-seqNo-floorNo" -> binId
  const binIndexMap = new Map<string, number>()
  for (let i = 0; i < allBins.length; i++) {
    const bin = allBins[i]
    const binClassNo = bin['class_no'] as number
    const binSeqNo = bin['seq_no'] as number
    const binFloorNo = bin['floor_no'] as number
    const binId = bin['id'] as number
    const key = `${binClassNo}-${binSeqNo}-${binFloorNo}`
    binIndexMap.set(key, binId)
  }

  // 收集安曲曲坯数据；后续工序复用安曲曲坯数，不能再次导出为安曲快照。
  const bins: AnQuBinData[] = []
  const skippedBins: string[] = []

  for (let i = 0; i < allSessions.length; i++) {
    const session = allSessions[i]
    const sessionRoundId = session['round_id'] as number | null
    const sessionStatus = session['status'] as string | null
    const sessionStageCode = session['stage_code'] as string | null

    // 只处理已提交的安曲数据
    if (sessionStatus != SESSION_STATUS_SUBMITTED || sessionStageCode != 'AN_QU') {
      continue
    }

    // 过滤轮次
    if (sessionRoundId != roundId) {
      continue
    }

    // 提取 bins 数据
    const sessionBins = session['bins']
    if (sessionBins != null) {
      const binArray = sessionBins as UTSJSONObject[]
      for (let j = 0; j < binArray.length; j++) {
        const bin = binArray[j]
        const binCode = bin['bin_code'] as string
        const kojiCount = bin['koji_count'] as number

        // 解析曲块编号
        const parsed = parseBinCode(binCode)
        if (parsed == null) {
          continue
        }

        const binClassNo = parsed['class_no'] as number
        const binSeqNo = parsed['seq_no'] as number
        const binFloorNo = parsed['floor_no'] as number

        // 检查是否跨班
        if (binClassNo != classNo) {
          skippedBins.push(binCode)
          continue
        }

        // 优先使用全局发酵仓表 ID；测试/迁移数据缺少全局表时回退到会话内稳定字段。
        const key = `${binClassNo}-${binSeqNo}-${binFloorNo}`
        const mappedBinSeq = binIndexMap.get(key)
        const sessionBinId = bin['bin_id'] as number | null
        const stageBinId = bin['stage_bin_id'] as number | null
        const binSeq = mappedBinSeq != null ? mappedBinSeq : (sessionBinId != null ? sessionBinId : (stageBinId != null ? stageBinId : binSeqNo))

        bins.push({
          id: binCode,
          seq: binSeq,
          floor: binFloorNo,
          koji: kojiCount
        })
      }
    }
  }

  return {
    v: 1,
    kind: PAYLOAD_KIND_ANQ,
    ts: getCurrentTimestamp(),
    c: classNo,
    y: year,
    n: roundNo,
    m: micro,
    f: floors,
    bins: bins,
    skip: skippedBins
  }
}

/**
 * 组装配置数据载荷
 * @param classNo 当前班次号
 * @param allPersons 所有人员数据（可选）
 * @param activeCoefSet 当前系数集（可选）
 * @param includePersons 是否包含人员数据
 * @param includeCoef 是否包含系数数据
 * @returns Config载荷
 */
export function assembleConfigPayload(
  classNo: number,
  allPersons: UTSJSONObject[] | null,
  activeCoefSet: UTSJSONObject | null,
  includePersons: boolean,
  includeCoef: boolean
): ConfigPayload {
  let personsData: PersonData[] | null = null
  if (includePersons && allPersons != null) {
    personsData = toTransferPersonData(allPersons)
  }

  let coefData: CoefData | null = null
  if (includeCoef && activeCoefSet != null) {
    coefData = toTransferCoefData(activeCoefSet)
  }

  return {
    v: 1,
    kind: PAYLOAD_KIND_CONFIG,
    ts: getCurrentTimestamp(),
    c: classNo,
    persons: personsData,
    coef: coefData
  }
}

/**
 * 组装完整配置包载荷
 * @param roundId 轮次ID
 * @param classNo 当前班次号
 * @param allRounds 所有轮次数据
 * @param allBins 所有曲块数据
 * @param allSessions 所有会话数据
 * @param allPersons 所有人员数据（可选）
 * @param activeCoefSet 当前系数集（可选）
 * @param includePersons 是否包含人员数据
 * @param includeCoef 是否包含系数数据
 * @returns Bundle载荷，如果轮次不存在返回null
 */
export function assembleBundlePayload(
  roundId: number,
  classNo: number,
  allRounds: UTSJSONObject[],
  floorConfig: UTSJSONObject | null,
  allBins: UTSJSONObject[],
  allSessions: UTSJSONObject[],
  allPersons: UTSJSONObject[] | null,
  activeCoefSet: UTSJSONObject | null,
  includePersons: boolean,
  includeCoef: boolean
): BundlePayload | null {
  const anquPayload = collectAnQuPayload(roundId, classNo, allRounds, floorConfig, allBins, allSessions)
  if (anquPayload == null) {
    return null
  }

  let personsData: PersonData[] | null = null
  if (includePersons && allPersons != null) {
    personsData = toTransferPersonData(allPersons)
  }

  let coefData: CoefData | null = null
  if (includeCoef && activeCoefSet != null) {
    coefData = toTransferCoefData(activeCoefSet)
  }

  return {
    v: 1,
    kind: PAYLOAD_KIND_BUNDLE,
    ts: getCurrentTimestamp(),
    c: classNo,
    anqu: anquPayload,
    persons: personsData,
    coef: coefData
  }
}

// ============================================
// 数据封装/解封
// ============================================

/**
 * 验证 AnQu 载荷结构
 * @param anquPayload AnQu 载荷对象
 * @param prefix 错误消息前缀（用于嵌套验证）
 * @returns 验证错误，无错误返回 null
 */
function createInvalidPayloadError(message: string, details: string | null = null): TransferError {
  return {
    code: 'INVALID_PAYLOAD',
    message: message,
    details: details
  }
}

function createEmptyBinsError(prefix: string): TransferError {
  return {
    code: 'EMPTY_BINS',
    message: `${prefix}ANQ 载荷 bins 不能为空`,
    details: '至少需要 1 个曲块'
  }
}

/**
 * 验证 AnQu 载荷结构
 * @param anquPayload AnQu 载荷对象
 * @param prefix 错误消息前缀（用于嵌套验证）
 * @returns 验证错误，无错误返回 null
 */
function validateAnQuPayload(anquPayload: UTSJSONObject, prefix: string = ''): TransferError | null {
  const anqFields = ['c', 'y', 'n', 'm', 'f', 'bins', 'skip']
  for (let i = 0; i < anqFields.length; i++) {
    const field = anqFields[i]
    if (anquPayload[field] == null) {
      return createInvalidPayloadError(
        `${prefix}ANQ 载荷缺少必需字段: ${field}`,
        `期望类型: ${field == 'f' || field == 'bins' || field == 'skip' ? 'array' : 'number'}`
      )
    }
  }

  const numFields = ['c', 'y', 'n', 'm', 'ts', 'v']
  for (let i = 0; i < numFields.length; i++) {
    const field = numFields[i]
    const value = anquPayload[field]
    if (value != null && typeof value != 'number') {
      return createInvalidPayloadError(`${prefix}字段 ${field} 类型错误`, `期望: number, 实际: ${typeof value}`)
    }
  }

  const arrayFields = ['f', 'bins', 'skip']
  for (let i = 0; i < arrayFields.length; i++) {
    const field = arrayFields[i]
    const value = anquPayload[field]
    if (!Array.isArray(value)) {
      return createInvalidPayloadError(`${prefix}字段 ${field} 类型错误`, `期望: array, 实际: ${typeof value}`)
    }
  }

  const bins = anquPayload['bins'] as any[]
  if (bins.length == 0) {
    return createEmptyBinsError(prefix)
  }

  const binIdSet = new Set<string>()
  const floorSeqMap = new Map<string, number>()
  for (let i = 0; i < bins.length; i++) {
    const bin = bins[i]
    if (typeof bin != 'object' || bin == null || Array.isArray(bin)) {
      return createInvalidPayloadError(`${prefix}bins[${i}] 不是有效对象`, `期望: object, 实际: ${typeof bin}`)
    }

    const binObj = bin as UTSJSONObject
    const binId = binObj['id']
    const binSeq = binObj['seq']
    const binFloor = binObj['floor']
    const binKoji = binObj['koji']

    if (binId == null || typeof binId != 'string') {
      return createInvalidPayloadError(`${prefix}bins[${i}].id 类型错误`, '期望类型: string')
    }
    if (binSeq == null || typeof binSeq != 'number') {
      return createInvalidPayloadError(`${prefix}bins[${i}].seq 类型错误`, '期望类型: number')
    }
    if (binFloor == null || typeof binFloor != 'number') {
      return createInvalidPayloadError(`${prefix}bins[${i}].floor 类型错误`, '期望类型: number')
    }
    if (binKoji == null || typeof binKoji != 'number') {
      return createInvalidPayloadError(`${prefix}bins[${i}].koji 类型错误`, '期望类型: number')
    }
    if (binIdSet.has(binId as string)) {
      return createInvalidPayloadError(`${prefix}bins 存在重复 id: ${binId as string}`, 'duplicate bin.id')
    }
    binIdSet.add(binId as string)

    const floorSeqKey = `${binFloor as number}-${binSeq as number}`
    const existedKoji = floorSeqMap.get(floorSeqKey)
    if (existedKoji != null) {
      if (existedKoji != (binKoji as number)) {
        return createInvalidPayloadError(`${prefix}bins 存在相同 floor+seq 但 koji 不同: ${floorSeqKey}`, 'same floor + seq but different koji')
      }
      return createInvalidPayloadError(`${prefix}bins 存在重复 floor+seq: ${floorSeqKey}`, 'duplicate floor + seq')
    }
    floorSeqMap.set(floorSeqKey, binKoji as number)
  }

  const floors = anquPayload['f'] as any[]
  const floorNoSet = new Set<number>()
  for (let i = 0; i < floors.length; i++) {
    const floor = floors[i]
    if (typeof floor != 'object' || floor == null || Array.isArray(floor)) {
      return createInvalidPayloadError(`${prefix}f[${i}] 结构错误`, '期望: FloorConfigPair')
    }

    const floorObj = floor as UTSJSONObject
    const floorNo = floorObj['floorNo']
    const maxSeqNo = floorObj['maxSeqNo']

    if (floorNo == null || typeof floorNo != 'number' || maxSeqNo == null || typeof maxSeqNo != 'number') {
      return createInvalidPayloadError(`${prefix}f[${i}] 元素类型错误`, '期望: {floorNo: number, maxSeqNo: number}')
    }
    if (floorNoSet.has(floorNo as number)) {
      return createInvalidPayloadError(`${prefix}f 存在重复 floorNo: ${floorNo as number}`, 'duplicate f.floorNo')
    }
    floorNoSet.add(floorNo as number)
  }

  const skip = anquPayload['skip'] as any[]
  for (let i = 0; i < skip.length; i++) {
    if (typeof skip[i] != 'string') {
      return createInvalidPayloadError(`${prefix}skip[${i}] 类型错误`, `期望: string, 实际: ${typeof skip[i]}`)
    }
  }

  return null
}

/**
 * 验证 persons 数组结构
 */
function validatePersonsArray(persons: any, prefix: string = ''): TransferError | null {
  if (!Array.isArray(persons)) {
    return createInvalidPayloadError(`${prefix}persons 类型错误`, '期望类型: PersonData[]')
  }

  const idSet = new Set<number>()
  const nameSet = new Set<string>()
  for (let i = 0; i < persons.length; i++) {
    const rawPerson = persons[i]
    if (typeof rawPerson != 'object' || rawPerson == null || Array.isArray(rawPerson)) {
      return createInvalidPayloadError(`${prefix}persons[${i}] 类型错误`, '期望类型: PersonData')
    }

    const person = rawPerson as UTSJSONObject
    const personId = person['id']
    const personName = person['name']
    const personSkill = person['skill']

    if (personId == null || typeof personId != 'number') {
      return createInvalidPayloadError(`${prefix}persons[${i}].id 类型错误`, '期望类型: number')
    }
    if (personName == null || typeof personName != 'string') {
      return createInvalidPayloadError(`${prefix}persons[${i}].name 类型错误`, '期望类型: string')
    }
    if (personSkill == null || typeof personSkill != 'number') {
      return createInvalidPayloadError(`${prefix}persons[${i}].skill 类型错误`, '期望类型: number')
    }
    if (idSet.has(personId as number)) {
      return createInvalidPayloadError(`${prefix}persons 存在重复 id: ${personId as number}`, 'duplicate person.id')
    }
    idSet.add(personId as number)

    const name = personName as string
    if (name.length > 0) {
      if (nameSet.has(name)) {
        return createInvalidPayloadError(`${prefix}persons 存在重复姓名: ${name}`, 'duplicate non-empty person.name')
      }
      nameSet.add(name)
    }
  }

  return null
}

/**
 * 验证 coef 对象结构
 */
function validateCoefData(coef: any, prefix: string = ''): TransferError | null {
  if (typeof coef != 'object' || coef == null || Array.isArray(coef)) {
    return createInvalidPayloadError(`${prefix}coef 类型错误`, '期望类型: CoefData')
  }

  const coefObj = coef as UTSJSONObject

  if (!Array.isArray(coefObj['stages'])) {
    return createInvalidPayloadError(`${prefix}coef.stages 类型错误`, '期望类型: StageCoefData[]')
  }

  const stageCodeSet = new Set<string>()
  const stages = coefObj['stages'] as any[]
  for (let i = 0; i < stages.length; i++) {
    const rawStage = stages[i]
    if (typeof rawStage != 'object' || rawStage == null || Array.isArray(rawStage)) {
      return createInvalidPayloadError(`${prefix}coef.stages[${i}] 类型错误`, '期望类型: StageCoefData')
    }

    const stage = rawStage as UTSJSONObject
    const stageCode = stage['code']
    const stageName = stage['name']
    const stageCoef = stage['coef']

    if (stageCode == null || typeof stageCode != 'string') {
      return createInvalidPayloadError(`${prefix}coef.stages[${i}].code 类型错误`, '期望类型: string')
    }
    if (stageName == null || typeof stageName != 'string') {
      return createInvalidPayloadError(`${prefix}coef.stages[${i}].name 类型错误`, '期望类型: string')
    }
    if (stageCoef == null || typeof stageCoef != 'number') {
      return createInvalidPayloadError(`${prefix}coef.stages[${i}].coef 类型错误`, '期望类型: number')
    }
    if (stageCodeSet.has(stageCode as string)) {
      return createInvalidPayloadError(`${prefix}coef.stages 存在重复 code: ${stageCode as string}`, 'duplicate coef.stages.code')
    }
    stageCodeSet.add(stageCode as string)
  }

  if (!Array.isArray(coefObj['duiQu'])) {
    return createInvalidPayloadError(`${prefix}coef.duiQu 类型错误`, '期望类型: DuiQuCoefItem[]')
  }

  const duiQuKeySet = new Set<string>()
  const duiQu = coefObj['duiQu'] as any[]
  for (let i = 0; i < duiQu.length; i++) {
    const rawItem = duiQu[i]
    if (typeof rawItem != 'object' || rawItem == null || Array.isArray(rawItem)) {
      return createInvalidPayloadError(`${prefix}coef.duiQu[${i}] 类型错误`, '期望类型: DuiQuCoefItem')
    }

    const item = rawItem as UTSJSONObject
    const itemKey = item['key']
    const itemValue = item['value']

    if (itemKey == null || typeof itemKey != 'string') {
      return createInvalidPayloadError(`${prefix}coef.duiQu[${i}].key 类型错误`, '期望类型: string')
    }
    if (itemValue == null || typeof itemValue != 'number') {
      return createInvalidPayloadError(`${prefix}coef.duiQu[${i}].value 类型错误`, '期望类型: number')
    }
    if (duiQuKeySet.has(itemKey as string)) {
      return createInvalidPayloadError(`${prefix}coef.duiQu 存在重复 key: ${itemKey as string}`, 'duplicate coef.duiQu.key')
    }
    duiQuKeySet.add(itemKey as string)
  }

  if (!Array.isArray(coefObj['liangTang'])) {
    return createInvalidPayloadError(`${prefix}coef.liangTang 类型错误`, '期望类型: LiangTangCoefItem[]')
  }

  const liangTangKeySet = new Set<string>()
  const liangTang = coefObj['liangTang'] as any[]
  for (let i = 0; i < liangTang.length; i++) {
    const rawItem = liangTang[i]
    if (typeof rawItem != 'object' || rawItem == null || Array.isArray(rawItem)) {
      return createInvalidPayloadError(`${prefix}coef.liangTang[${i}] 类型错误`, '期望类型: LiangTangCoefItem')
    }

    const item = rawItem as UTSJSONObject
    const itemKey = item['key']
    const itemValue = item['value']

    if (itemKey == null || typeof itemKey != 'string') {
      return createInvalidPayloadError(`${prefix}coef.liangTang[${i}].key 类型错误`, '期望类型: string')
    }
    if (itemValue == null || typeof itemValue != 'number') {
      return createInvalidPayloadError(`${prefix}coef.liangTang[${i}].value 类型错误`, '期望类型: number')
    }
    if (liangTangKeySet.has(itemKey as string)) {
      return createInvalidPayloadError(`${prefix}coef.liangTang 存在重复 key: ${itemKey as string}`, 'duplicate coef.liangTang.key')
    }
    liangTangKeySet.add(itemKey as string)
  }

  return null
}

/**
 * 验证 Config 载荷结构
 */
export function validateConfigPayload(payload: UTSJSONObject, prefix: string = ''): TransferError | null {
  if (payload['c'] == null || typeof payload['c'] != 'number') {
    return createInvalidPayloadError(`${prefix}缺少或类型错误: c`, '期望类型: number')
  }

  if (payload['persons'] == null && payload['coef'] == null) {
    return createInvalidPayloadError(`${prefix}CONFIG 包未包含人员或系数`, 'persons == null && coef == null')
  }

  if (payload['persons'] != null) {
    const personsError = validatePersonsArray(payload['persons'] as any, `${prefix}`)
    if (personsError != null) {
      return personsError
    }
  }

  if (payload['coef'] != null) {
    const coefError = validateCoefData(payload['coef'] as any, `${prefix}`)
    if (coefError != null) {
      return coefError
    }
  }

  return null
}

/**
 * 验证 Bundle 载荷结构
 */
export function validateBundlePayload(payload: UTSJSONObject, prefix: string = ''): TransferError | null {
  if (payload['c'] == null || typeof payload['c'] != 'number') {
    return createInvalidPayloadError(`${prefix}缺少或类型错误: c`, '期望类型: number')
  }

  if (payload['anqu'] == null || !isUTSObject(payload['anqu'])) {
    return createInvalidPayloadError(`${prefix}字段类型错误: anqu`, '期望类型: object')
  }

  const anquPayload = payload['anqu'] as UTSJSONObject
  const anquError = validateAnQuPayload(anquPayload, `${prefix}anqu: `)
  if (anquError != null) {
    return anquError
  }

  if (payload['persons'] != null) {
    const personsError = validatePersonsArray(payload['persons'] as any, `${prefix}`)
    if (personsError != null) {
      return personsError
    }
  }

  if (payload['coef'] != null) {
    const coefError = validateCoefData(payload['coef'] as any, `${prefix}`)
    if (coefError != null) {
      return coefError
    }
  }

  return null
}

function buildAnQuPayloadFromJSON(payloadObj: UTSJSONObject): AnQuPayload {
  const floorsRaw = readObjectArray(payloadObj, 'f')
  const floors: FloorConfigPair[] = []
  for (let i = 0; i < floorsRaw.length; i++) {
    const floorObj = floorsRaw[i]
    floors.push({
      floorNo: floorObj['floorNo'] as number,
      maxSeqNo: floorObj['maxSeqNo'] as number
    })
  }

  const binsRaw = readObjectArray(payloadObj, 'bins')
  const bins: AnQuBinData[] = []
  for (let i = 0; i < binsRaw.length; i++) {
    const binObj = binsRaw[i]
    bins.push({
      id: binObj['id'] as string,
      seq: binObj['seq'] as number,
      floor: binObj['floor'] as number,
      koji: binObj['koji'] as number
    })
  }

  return {
    v: 1,
    kind: PAYLOAD_KIND_ANQ,
    ts: payloadObj['ts'] as number,
    c: payloadObj['c'] as number,
    y: payloadObj['y'] as number,
    n: payloadObj['n'] as number,
    m: payloadObj['m'] as number,
    f: floors,
    bins: bins,
    skip: readStringArray(payloadObj, 'skip')
  }
}

function buildCoefDataFromJSON(coefObj: UTSJSONObject): CoefData {
  const stagesRaw = readObjectArray(coefObj, 'stages')
  const stages: StageCoefData[] = []
  for (let i = 0; i < stagesRaw.length; i++) {
    const stage = stagesRaw[i]
    stages.push({
      code: stage['code'] as string,
      name: stage['name'] as string,
      coef: stage['coef'] as number
    })
  }

  const duiQuRaw = readObjectArray(coefObj, 'duiQu')
  const duiQu: DuiQuCoefItem[] = []
  for (let i = 0; i < duiQuRaw.length; i++) {
    const item = duiQuRaw[i]
    duiQu.push({ key: item['key'] as string, value: item['value'] as number })
  }

  const liangTangRaw = readObjectArray(coefObj, 'liangTang')
  const liangTang: LiangTangCoefItem[] = []
  for (let i = 0; i < liangTangRaw.length; i++) {
    const item = liangTangRaw[i]
    liangTang.push({ key: item['key'] as string, value: item['value'] as number })
  }

  return { stages, duiQu, liangTang }
}

function buildPersonsFromJSON(payloadObj: UTSJSONObject): PersonData[] | null {
  if (payloadObj['persons'] == null) {
    return null
  }
  const personsRaw = readObjectArray(payloadObj, 'persons')
  const persons: PersonData[] = []
  for (let i = 0; i < personsRaw.length; i++) {
    const person = personsRaw[i]
    persons.push({
      id: person['id'] as number,
      name: person['name'] as string,
      skill: person['skill'] as number
    })
  }
  return persons
}

function buildConfigPayloadFromJSON(payloadObj: UTSJSONObject): ConfigPayload {
  const coefObj = readObject(payloadObj, 'coef')
  return {
    v: 1,
    kind: PAYLOAD_KIND_CONFIG,
    ts: payloadObj['ts'] as number,
    c: payloadObj['c'] as number,
    persons: buildPersonsFromJSON(payloadObj),
    coef: coefObj != null ? buildCoefDataFromJSON(coefObj) : null
  }
}

function buildBundlePayloadFromJSON(payloadObj: UTSJSONObject): BundlePayload {
  const anquObj = readObject(payloadObj, 'anqu') as UTSJSONObject
  const coefObj = readObject(payloadObj, 'coef')
  return {
    v: 1,
    kind: PAYLOAD_KIND_BUNDLE,
    ts: payloadObj['ts'] as number,
    c: payloadObj['c'] as number,
    anqu: buildAnQuPayloadFromJSON(anquObj),
    persons: buildPersonsFromJSON(payloadObj),
    coef: coefObj != null ? buildCoefDataFromJSON(coefObj) : null
  }
}

/**
 * 封装载荷为 JSON 字符串（用于剪切板传输）
 * @param payload 载荷对象（AnQuPayload、ConfigPayload 或 BundlePayload）
 * @returns JSON 格式字符串
 */
export function seal(payload: TransferPayload): string {
  return JSON.stringify(payload)
}

/**
 * 解封 JSON 格式数据（用于剪切板传输）
 * @param text JSON 格式字符串
 * @returns 解封结果，包含载荷或错误
 */
export function unseal(text: string): UnsealResult {
  try {
    const payload = JSON.parse(text)
    if (!isUTSObject(payload)) {
      return {
        success: false,
        payload: null,
        error: createInvalidPayloadError('导入数据不是有效对象', '期望 JSON object')
      }
    }

    const payloadObj = payload as UTSJSONObject

    const requiredFields = ['v', 'kind', 'ts']
    for (let i = 0; i < requiredFields.length; i++) {
      const field = requiredFields[i]
      if (payloadObj[field] == null) {
        return {
          success: false,
          payload: null,
          error: createInvalidPayloadError(
            `缺少必需字段: ${field}`,
            `期望类型: ${field == 'v' ? 'number' : field == 'kind' ? 'string' : 'number'}`
          )
        }
      }
    }

    if (typeof payloadObj['v'] != 'number' || typeof payloadObj['kind'] != 'string' || typeof payloadObj['ts'] != 'number') {
      return {
        success: false,
        payload: null,
        error: createInvalidPayloadError('基础字段类型错误', 'v:number, kind:string, ts:number')
      }
    }

    const kind = payloadObj['kind'] as string
    let decodedPayload: TransferPayload | null = null

    if (kind == PAYLOAD_KIND_ANQ) {
      const validationError = validateAnQuPayload(payloadObj, '')
      if (validationError != null) {
        return { success: false, payload: null, error: validationError }
      }
      decodedPayload = buildAnQuPayloadFromJSON(payloadObj)
    } else if (kind == PAYLOAD_KIND_CONFIG) {
      const validationError = validateConfigPayload(payloadObj, '')
      if (validationError != null) {
        return { success: false, payload: null, error: validationError }
      }
      decodedPayload = buildConfigPayloadFromJSON(payloadObj)
    } else if (kind == PAYLOAD_KIND_BUNDLE) {
      const validationError = validateBundlePayload(payloadObj, '')
      if (validationError != null) {
        return { success: false, payload: null, error: validationError }
      }
      decodedPayload = buildBundlePayloadFromJSON(payloadObj)
    } else {
      return {
        success: false,
        payload: null,
        error: createInvalidPayloadError(`未知的数据类型: ${kind}`, '期望: ANQ, CONFIG 或 BUNDLE')
      }
    }

    return {
      success: true,
      payload: decodedPayload,
      error: null
    }
  } catch (e: any) {
    return {
      success: false,
      payload: null,
      error: {
        code: 'DECODE_FAILED',
        message: 'JSON 解析失败',
        details: safeErrorMessage(e)
      }
    }
  }
}

// ============================================
// 辅助函数
// ============================================
// ============================================
// DTO 转换函数
// ============================================

/**
 * 楼层配置转换为传输格式
 */
export function convertFloorConfigToPairs(config: UTSJSONObject | null): FloorConfigPair[] {
  if (config == null) {
    return []
  }
  const pairs: FloorConfigPair[] = []

  // 使用 for-in 遍历 UTSJSONObject
  for (const key in config) {
    const floorNo = parseInt(key)
    const maxSeqNo = config[key] as number
    if (!isNaN(floorNo)) {
      pairs.push({ floorNo, maxSeqNo })
    }
  }

  // 按 floorNo 排序
  pairs.sort((a, b) => a.floorNo - b.floorNo)

  return pairs
}

/**
 * 传输格式转换为楼层配置
 */
export function convertFloorPairsToConfig(floors: FloorConfigPair[]): UTSJSONObject {
  const config = {} as UTSJSONObject
  for (let i = 0; i < floors.length; i++) {
    const floorNo = floors[i].floorNo
    const maxSeqNo = floors[i].maxSeqNo
    config[floorNo.toString()] = maxSeqNo
  }
  return config
}

/**
 * 人员数据转换为传输格式
 */
export function toTransferPersonData(persons: UTSJSONObject[]): PersonData[] {
  const result: PersonData[] = []
  for (let i = 0; i < persons.length; i++) {
    const person = persons[i]
    result.push({
      id: readNumber(person, 'id'),
      name: readString(person, 'name'),
      skill: readNumber(person, 'skill_level', 0)
    })
  }
  return result
}

/**
 * 传输格式转换为人员数据
 */
export function fromTransferPersonData(persons: PersonData[]): UTSJSONObject[] {
  const result: UTSJSONObject[] = []
  for (let i = 0; i < persons.length; i++) {
    const person = persons[i]
    result.push({
      id: person.id,
      name: person.name,
      skill_level: person.skill
    } as UTSJSONObject)
  }
  return result
}

/**
 * 系数数据转换为传输格式
 */
export function toTransferCoefData(activeCoefSet: UTSJSONObject): CoefData {
  const rawStagesObj = readObject(activeCoefSet, 'stages')
  const rawDuiQu = readObject(activeCoefSet, 'duiQu')
  const rawLiangTang = readObject(activeCoefSet, 'liangTang')

  const stages: StageCoefData[] = []
  const duiQu: DuiQuCoefItem[] = []
  const liangTang: LiangTangCoefItem[] = []

  // stages 在存储层是以对象形式存储的 { [code]: {stage_code, stage_name, coef} }
  if (rawStagesObj != null) {
    for (const key in rawStagesObj) {
      const stage = rawStagesObj[key]
      if (isUTSObject(stage)) {
        const stageObj = stage as UTSJSONObject
        stages.push({
          code: readString(stageObj, 'stage_code'),
          name: readString(stageObj, 'stage_name'),
          coef: readNumber(stageObj, 'coef', 1.0)
        })
      }
    }
  }

  // 使用 for-in 遍历 duiQu
  if (rawDuiQu != null) {
    for (const key in rawDuiQu) {
      const value = rawDuiQu[key]
      if (typeof value === 'number') {
        duiQu.push({ key, value: value as number })
      }
   }
    // 按 key 排序（使用简单比较，UTS 不支持 localeCompare）
    duiQu.sort((a, b) => {
      if (a.key < b.key) return -1
      if (a.key > b.key) return 1
      return 0
    })
  }

  // 使用 for-in 遍历 liangTang
  if (rawLiangTang != null) {
    for (const key in rawLiangTang) {
      const value = rawLiangTang[key]
      if (typeof value === 'number') {
        liangTang.push({ key, value: value as number })
      }
    }
    // 按 key 排序
    liangTang.sort((a, b) => {
      if (a.key < b.key) return -1
      if (a.key > b.key) return 1
      return 0
    })
  }

  return { stages, duiQu, liangTang }
}

/**
 * 传输格式转换为存储系数stages
 */
export function toStorageCoefStages(stages: StageCoefData[]): UTSJSONObject[] {
  const result: UTSJSONObject[] = []
  for (let i = 0; i < stages.length; i++) {
    const stage = stages[i]
    result.push({
      stage_code: stage.code,
      stage_name: stage.name,
      coef: stage.coef
    } as UTSJSONObject)
  }
  return result
}

/**
 * 传输格式转换为存储duiQu映射
 */
export function toStorageDuiQuMap(items: DuiQuCoefItem[]): UTSJSONObject {
  const result = {} as UTSJSONObject
  for (let i = 0; i < items.length; i++) {
    result[items[i].key] = items[i].value
  }
  return result
}

/**
 * 传输格式转换为存储liangTang映射
 */
export function toStorageLiangTangMap(items: LiangTangCoefItem[]): UTSJSONObject {
  const result = {} as UTSJSONObject
  for (let i = 0; i < items.length; i++) {
    result[items[i].key] = items[i].value
  }
  return result
}

/**
 * 传输格式系数转换为存储格式（完整转换）
 * 这是 toTransferCoefData 的反向函数
 */
export function fromTransferCoefData(coef: CoefData): UTSJSONObject {
  const normalized = normalizeTransferCoefData(coef)
  return {
    stages: toStorageCoefStages(normalized.stages),
    duiQu: toStorageDuiQuMap(normalized.duiQu),
    liangTang: toStorageLiangTangMap(normalized.liangTang)
  } as UTSJSONObject
}

/**
 * 合并导入的系数到当前激活版本
 */
export function mergeImportedCoefIntoActiveSet(
  importedCoef: CoefData,
  currentCoefSet: UTSJSONObject | null
): UTSJSONObject | null {
  if (currentCoefSet == null) {
    return null
  }

  return {
    id: currentCoefSet['id'],
    name: currentCoefSet['name'],
    effectiveFrom: currentCoefSet['effectiveFrom'],
    effectiveTo: currentCoefSet['effectiveTo'],
    stages: toStorageCoefStages(importedCoef.stages),
    duiQu: toStorageDuiQuMap(importedCoef.duiQu),
    liangTang: toStorageLiangTangMap(importedCoef.liangTang)
  } as UTSJSONObject
}

/**
 * 构建安曲快照项
 */
export function buildAnQuSnapshotItems(bins: AnQuBinData[]): ParsedAnQuItem[] {
  const result: ParsedAnQuItem[] = []
  for (let i = 0; i < bins.length; i++) {
    const bin = bins[i]
    result.push({
      binCode: bin.id,
      kojiCount: bin.koji,
      lineNumber: i + 1,
      hasError: false,
      errorMessage: '',
      errorCode: ''
    })
  }
  return result
}

// ============================================
// Payload 辅助函数
// ============================================

/**
 * 提取 payload 的班次号
 */
export function extractPayloadClassNo(payload: TransferPayload): number | null {
  // 直接通过动态字段访问，避免整包类型转换
  return payload['c'] as number | null
}

/**
 * 验证班次匹配
 */
export function validateClassMatch(payloadClassNo: number | null, currentClassNo: number): TransferError | null {
  if (payloadClassNo == null) {
    return {
      code: 'INVALID_PAYLOAD',
      message: '无法提取 payload 班次号',
      details: null
    }
  }
  if (payloadClassNo != currentClassNo) {
    return {
      code: 'CLASS_MISMATCH',
      message: '班次不匹配',
      details: `当前班次: ${currentClassNo}, 导入班次: ${payloadClassNo}`
    }
  }
  return null
}

// ============================================
// 冲突检测函数
// ============================================

/**
 * 检测楼层配置冲突
 */
export function checkFloorConfigConflict(
  importedFloors: FloorConfigPair[],
  localFloorConfig: UTSJSONObject | null
): FloorConflictItem | null {
  const localPairs = convertFloorConfigToPairs(localFloorConfig)

  const localMap = new Map<number, number>()
  for (let i = 0; i < localPairs.length; i++) {
    localMap.set(localPairs[i].floorNo, localPairs[i].maxSeqNo)
  }

  const importedMap = new Map<number, number>()
  for (let i = 0; i < importedFloors.length; i++) {
    importedMap.set(importedFloors[i].floorNo, importedFloors[i].maxSeqNo)
  }

  let hasConflict = false
  const allFloors = new Set<number>()

  for (let i = 0; i < localPairs.length; i++) {
    allFloors.add(localPairs[i].floorNo)
  }
  for (let i = 0; i < importedFloors.length; i++) {
    allFloors.add(importedFloors[i].floorNo)
  }

  const floorArray = Array.from(allFloors)
  for (let i = 0; i < floorArray.length; i++) {
    const floor = floorArray[i]
    const localMax = localMap.get(floor)
    const importedMax = importedMap.get(floor)
    if (localMax != importedMax) {
      hasConflict = true
      break
    }
  }

  if (!hasConflict) {
    return null
  }

  return {
    type: 'FLOOR_CONFIG',
    title: '楼层配置冲突',
    summary: '导入的楼层配置与本地不一致',
    details: null,
    localFloors: localPairs,
    importedFloors: importedFloors
  }
}

/**
 * 检测花名册冲突
 */
export function checkRosterConflict(
  importedPersons: PersonData[] | null,
  localPersons: UTSJSONObject[]
): ConflictItem | null {
  if (importedPersons == null) {
    return null
  }

  const localMap = new Map<number, UTSJSONObject>()
  for (let i = 0; i < localPersons.length; i++) {
    const person = localPersons[i]
    localMap.set(person['id'] as number, person)
  }

  const importedMap = new Map<number, PersonData>()
  for (let i = 0; i < importedPersons.length; i++) {
    const person = importedPersons[i]
    importedMap.set(person.id, person)
  }

  let added = 0
  let removed = 0
  let modified = 0

  for (let i = 0; i < importedPersons.length; i++) {
    const imported = importedPersons[i]
    const local = localMap.get(imported.id)
    if (local == null) {
      added++
    } else {
      const localName = local['name'] as string
      const localSkill = local['skill_level'] as number
      if (localName != imported.name || localSkill != imported.skill) {
        modified++
      }
    }
  }

  for (let i = 0; i < localPersons.length; i++) {
    const local = localPersons[i]
    const id = local['id'] as number
    if (!importedMap.has(id)) {
      removed++
    }
  }

  if (added == 0 && removed == 0 && modified == 0) {
    return null
  }

  return {
    type: 'ROSTER',
    title: '花名册冲突',
    summary: `新增 ${added} 人，删除 ${removed} 人，修改 ${modified} 人`,
    details: null
  }
}

/**
 * 检测系数冲突
 */
export function checkCoefConflict(
  importedCoef: CoefData | null,
  activeCoefSet: UTSJSONObject | null
): ConflictItem | null {
  if (importedCoef == null) {
    return null
  }

  if (activeCoefSet == null) {
    return null
  }

  const localCoef = toTransferCoefData(activeCoefSet)

  const importedStr = JSON.stringify(importedCoef)
  const localStr = JSON.stringify(localCoef)

  if (importedStr == localStr) {
    return null
  }

  return {
    type: 'COEF',
    title: '系数冲突',
    summary: '导入的系数与本地不一致',
    details: null
  }
}

/**
 * 检测导入冲突
 */
export function detectImportConflicts(
  payload: TransferPayload,
  localFloorConfig: UTSJSONObject | null,
  localPersons: UTSJSONObject[],
  activeCoefSet: UTSJSONObject | null
): ImportConflictSummary | null {
  const items: ImportConflictItem[] = []
  // 通过字段判断类型，避免运行时类型转换
  const kind = payload['kind'] as string

  if (kind == 'ANQ') {
    const anqPayload = payload as AnQuPayload
    const floorConflict = checkFloorConfigConflict(anqPayload.f, localFloorConfig)
    if (floorConflict != null) {
      items.push(floorConflict)
    }
  } else if (kind == 'CONFIG') {
    const configPayload = payload as ConfigPayload
    const rosterConflict = checkRosterConflict(configPayload.persons, localPersons)
    if (rosterConflict != null) {
      items.push(rosterConflict)
    }
    const coefConflict = checkCoefConflict(configPayload.coef, activeCoefSet)
    if (coefConflict != null) {
      items.push(coefConflict)
    }
  } else if (kind == 'BUNDLE') {
    const bundlePayload = payload as BundlePayload
    const floorConflict = checkFloorConfigConflict(bundlePayload.anqu.f, localFloorConfig)
    if (floorConflict != null) {
      items.push(floorConflict)
    }
    const rosterConflict = checkRosterConflict(bundlePayload.persons, localPersons)
    if (rosterConflict != null) {
      items.push(rosterConflict)
    }
    const coefConflict = checkCoefConflict(bundlePayload.coef, activeCoefSet)
    if (coefConflict != null) {
      items.push(coefConflict)
    }
  }

  if (items.length == 0) {
    return null
  }

  return {
    hasConflict: true,
    items: items
  }
}

/**
 * 解析轮次映射
 * @param payload 安曲载荷
 * @returns 轮次解析结果
 */
export function resolveRound(payload: AnQuPayload, allRounds: UTSJSONObject[]): RoundResolveResult {
  const classNo = payload.c
  const year = payload.y
  const roundNo = payload.n
  const micro = payload.m

  const exactMatches: RoundCandidate[] = []
  const softMatches: RoundCandidate[] = []

  // 遍历所有轮次，查找匹配
  for (let i = 0; i < allRounds.length; i++) {
    const round = allRounds[i]
    const rClassNo = round['class_no'] as number
    const rYear = round['year'] as number
    const rRoundNo = round['round_no'] as number
    // Null 安全处理：本地轮次只读取 micro_enabled
    const rMicroValue = round['micro_enabled']
    const rMicro = rMicroValue != null ? rMicroValue as number : 0
    const rId = round['id'] as number

    // 精确匹配：(classNo, year, roundNo, micro) 全部相同
    if (rClassNo == classNo && rYear == year && rRoundNo == roundNo && rMicro == micro) {
      exactMatches.push({
        roundId: rId,
        classNo: rClassNo,
        year: rYear,
        roundNo: rRoundNo,
        micro: rMicro,
        label: `${rYear}年 第${rRoundNo}轮 (微调${rMicro})`
      })
    }
    // 软匹配：(classNo, year, roundNo) 相同，micro 不同
    else if (rClassNo == classNo && rYear == year && rRoundNo == roundNo) {
      softMatches.push({
        roundId: rId,
        classNo: rClassNo,
        year: rYear,
        roundNo: rRoundNo,
        micro: rMicro,
        label: `${rYear}年 第${rRoundNo}轮 (微调${rMicro})`
      })
    }
  }

  // 1. 精确匹配：只有一个
  if (exactMatches.length == 1) {
    return {
      status: 'EXACT_MATCH',
      roundId: exactMatches[0].roundId,
      candidates: null,
      warnings: null
    }
  }

  // 2. 精确匹配：多个（理论上不应该发生）
  if (exactMatches.length > 1) {
    return {
      status: 'AMBIGUOUS',
      roundId: null,
      candidates: exactMatches,
      warnings: ['发现多个完全匹配的轮次，请选择一个']
    }
  }

  // 3. 软匹配：只有一个
  if (softMatches.length == 1) {
    const warnings: string[] = []
    warnings.push(`微调版本不同：导入数据为 ${micro}，本地为 ${softMatches[0].micro}`)
    return {
      status: 'SOFT_MATCH',
      roundId: softMatches[0].roundId,
      candidates: null,
      warnings: warnings
    }
  }

  // 4. 软匹配：多个
  if (softMatches.length > 1) {
    return {
      status: 'AMBIGUOUS',
      roundId: null,
      candidates: softMatches,
      warnings: ['发现多个可能匹配的轮次（微调版本不同），请选择一个']
    }
  }

  // 5. 无匹配
  return {
    status: 'NOT_FOUND',
    roundId: null,
    candidates: null,
    warnings: [`未找到匹配的轮次：${year}年 第${roundNo}轮`]
  }
}
