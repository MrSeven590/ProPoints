}

// ============ 操作日志（二期同步预留）============

/**
 * 操作类型
 */
export type OpType = 'create' | 'update' | 'delete'

/**
 * 添加操作日志
 * @param opType 操作类型
 * @param entityType 实体类型
 * @param entityId 实体ID
 * @param data 数据快照
 */
export function addOplog(
  opType: OpType,
  entityType: string,
  entityId: string,
  data: UTSJSONObject | null
): void {
  const oplogData = loadData(getOplogKey())
  let logs: UTSJSONObject[] = []
  if (oplogData != null) {
    const items = oplogData['items']
    if (items != null) {
      logs = items as UTSJSONObject[]
    }
  }

  const logEntry = {
    opType: opType,
    entityType: entityType,
    entityId: entityId,
    data: data,
    timestamp: Date.now(),
    synced: false
  } as UTSJSONObject

  logs.push(logEntry)

  const newData = { items: logs } as UTSJSONObject
  saveData(getOplogKey(), newData)
}

/**
 * 获取未同步的操作日志
 */
export function getUnsyncedOplogs(): UTSJSONObject[] {
  const oplogData = loadData(getOplogKey())
  if (oplogData == null) {
    return []
  }
  const items = oplogData['items']
  if (items == null) {
    return []
  }
  const logs = items as UTSJSONObject[]
  const unsynced: UTSJSONObject[] = []
  for (let i = 0; i < logs.length; i++) {
    const synced = logs[i]['synced']
    if (synced == false) {
      unsynced.push(logs[i])
    }
  }
  return unsynced
}

/**
 * 标记操作日志为已同步
 * @param timestamp 日志时间戳
 */
export function markOplogSynced(timestamp: number): void {
  const oplogData = loadData(getOplogKey())
  if (oplogData == null) {
    return
  }
  const items = oplogData['items']
  if (items == null) {
    return
  }
  const logs = items as UTSJSONObject[]
  for (let i = 0; i < logs.length; i++) {
    const ts = logs[i]['timestamp'] as number
    if (ts == timestamp) {
      logs[i]['synced'] = true
    }
  }
  const newData = { items: logs } as UTSJSONObject
  saveData(getOplogKey(), newData)
}

/**
 * 清理已同步的操作日志
 */
export function clearSyncedOplogs(): void {
  const oplogData = loadData(getOplogKey())
  if (oplogData == null) {
    return
  }
  const items = oplogData['items']
  if (items == null) {
    return
  }
  const logs = items as UTSJSONObject[]
  const unsynced: UTSJSONObject[] = []
  for (let i = 0; i < logs.length; i++) {
    const synced = logs[i]['synced']
    if (synced == false) {
      unsynced.push(logs[i])
    }
  }
  const newData = { items: unsynced } as UTSJSONObject
  saveData(getOplogKey(), newData)
}

/**
 * 检查指定轮次ID是否有任何会话数据（草稿或已提交）
 * 注意：草稿 key 格式为 pp:session:{date}:{stage}:{roundId}:draft（6段），
 * 已提交 key 格式为 pp:session:{date}:{stage}:{roundId}（5段），
 * parseSessionKey 只处理5段格式会漏判草稿，因此这里用字符串匹配。
 * @param roundId 轮次ID
 * @returns 是否存在会话数据
 */
export function hasSessionDataForRoundId(roundId: number): boolean {
  const keys = listAllSessionKeys()
  const roundIdStr = roundId.toString()

  for (let i = 0; i < keys.length; i++) {
    // key 格式: pp:session:{date}:{stage}:{roundId} 或 pp:session:{date}:{stage}:{roundId}:draft
    // 检查倒数第二段或最后一段是否为 roundId
    const parts = keys[i].split(':')
    // 已提交(5段): parts[4] = roundId
    // 草稿(6段): parts[4] = roundId, parts[5] = 'draft'
    if (parts.length >= 5 && parts[4] == roundIdStr) {
      return true
    }
  }

  return false
}

/**
 * 删除指定轮次ID的所有草稿会话数据（用于清理残留草稿）
 * @param roundId 轮次ID
 */
export function deleteDraftSessionsByRoundId(roundId: number): void {
  const keys = listAllSessionKeys()
  const roundIdStr = roundId.toString()

  for (let i = 0; i < keys.length; i++) {
    const parts = keys[i].split(':')
    // 草稿格式: pp:session:{date}:{stage}:{roundId}:draft (6段)
    if (parts.length == 6 && parts[4] == roundIdStr && parts[5] == 'draft') {
      removeData(keys[i])
      removeFromIndex(getDraftIndexKey(), keys[i])
    }
  }
}

/**
 * 列出所有会话 key
 * @returns 所有以 'pp:session:' 开头的 key 列表
 */
export function listAllSessionKeys(): string[] {
  const info = uni.getStorageInfoSync()
  const keys = info.keys
  const sessionKeys: string[] = []

  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (isSessionKey(key)) {
      sessionKeys.push(key)
    }
  }

  return sessionKeys
}

// ============ MiMo AI 识图配置 ============

/**
 * 保存 MiMo API Key
 * @param apiKey API Key 字符串
 */
export function saveMiMoApiKey(apiKey: string): void {
  const data = { apiKey: apiKey } as UTSJSONObject
  saveData(getMimoApiKeyKey(), data)
}

/**
 * 加载 MiMo API Key
 * @returns API Key 字符串，不存在返回 null
 */
export function loadMiMoApiKey(): string | null {
  const data = loadData(getMimoApiKeyKey())
  if (data == null) {
    return null
  }
  const apiKey = data['apiKey']
  if (apiKey == null) {
    return null
  }
  return apiKey as string
}

