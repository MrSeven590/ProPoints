/**
 * 保存 OCR 识图历史记录列表
 * @param history 历史记录数组（UTSJSONObject[]，含识别结果、stageCode、timestamp，可选 imagePath）
 */
export function saveOcrHistory(history: UTSJSONObject[]): void {
  const wrapper = { list: history } as UTSJSONObject
  saveData(getOcrHistoryKey(), wrapper)
}

/**
 * 加载 OCR 识图历史记录列表
 * @returns 历史记录数组，不存在返回空数组
 */
export function loadOcrHistory(): UTSJSONObject[] {
  const data = loadData(getOcrHistoryKey())
  if (data == null) {
    return [] as UTSJSONObject[]
  }
  const list = data['list']
  if (list == null) {
    return [] as UTSJSONObject[]
  }
  return list as UTSJSONObject[]
}

/**
 * 清空 OCR 识图历史记录
 */
export function clearOcrHistory(): void {
  removeData(getOcrHistoryKey())
}
