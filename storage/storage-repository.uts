/**
 * Storage Repository
 * uni.*Storage 读写封装（文档化存储）
 * ProPoints 工分管理系统
 */

import {
  getSessionKey,
  getSessionDraftKey,
  getDateIndexKey,
  getDraftIndexKey,
  getPersonIndexKey,
  getPersonIndexKeyPrefix,
  getBinIndexKey,
  getBinIndexKeyPrefix,
  getPersonsKey,
  getBinsKey,
  getRoundsKey,
  getRoleTypesKey,
  getStageTypesKey,
  getStageRoleDefaultsKey,
  getSkillCoeffsKey,
  getClassConfigKey,
  getCoefSetKey,
  getCoefSetsIndexKey,
  getActiveCoefSetKey,
  getRoundConfigKey,
  getLiangTangDefaultKey,
  getDuiQuDefaultKey,
  getManagerNameKey,
  getBinSeqMaxByFloorKey,
  getOplogKey,
  parseSessionKey,
  isSessionKey,
  getMimoApiKeyKey,
  getMimoModelKey,
  getMimoProtocolKey,
  getMimoBaseUrlKey,
  getMimoUseBuiltinKey,
  getOcrHistoryKey
} from './storage-keys.uts'

// ============ 通用读写方法 ============

/**
 * 保存数据到 Storage
 * @param key 存储键
 * @param data 数据对象
 */
export function saveData(key: string, data: UTSJSONObject): void {
  uni.setStorageSync(key, data)
}

/**
 * 从 Storage 读取数据
 * @param key 存储键
 * @returns 数据对象，不存在时返回 null
 */
export function loadData(key: string): UTSJSONObject | null {
  const result = uni.getStorageSync(key)
  if (result == '' || result == null) {
    return null
  }
  // getStorageSync 返回 any，需要转换
  return result as UTSJSONObject
}

/**
 * 删除 Storage 中的数据
 * @param key 存储键
 */
export function removeData(key: string): void {
  uni.removeStorageSync(key)
}

/**
 * 检查 key 是否存在
 * @param key 存储键
 * @returns 是否存在
 */
export function hasKey(key: string): boolean {
  const result = uni.getStorageSync(key)
  return result != '' && result != null
}

// ============ 索引管理 ============

/**
 * 添加到索引列表
 * @param indexKey 索引 key
 * @param value 要添加的值
 */
export function addToIndex(indexKey: string, value: string): void {
  const existing = loadData(indexKey)
  let list: string[] = []
  if (existing != null) {
    const items = existing['items']
    if (items != null) {
      list = items as string[]
    }
  }
  // 避免重复
  if (list.indexOf(value) == -1) {
    list.push(value)
    const data = { items: list } as UTSJSONObject
    saveData(indexKey, data)
  }
}

/**
 * 从索引列表移除
 * @param indexKey 索引 key
 * @param value 要移除的值
 */
export function removeFromIndex(indexKey: string, value: string): void {
  const existing = loadData(indexKey)
  if (existing == null) {
    return
  }
  const items = existing['items']
  if (items == null) {
    return
  }
  const list = items as string[]
  const index = list.indexOf(value)
  if (index != -1) {
    list.splice(index, 1)
    const data = { items: list } as UTSJSONObject
    saveData(indexKey, data)
  }
}

/**
 * 获取索引列表
 * @param indexKey 索引 key
 * @returns 值列表
 */
export function getIndexList(indexKey: string): string[] {
  const existing = loadData(indexKey)
  if (existing == null) {
    return []
  }
  const items = existing['items']
  if (items == null) {
    return []
  }
  return items as string[]
}

function addUniqueNumber(target: number[], value: number | null): void {
  if (value == null) {
    return
  }
  if (target.indexOf(value) == -1) {
    target.push(value)
  }
}

function addSessionWorkerPersonIds(target: number[], workersRaw: any | null): void {
  if (workersRaw == null || !Array.isArray(workersRaw)) {
    return
  }
  const workers = workersRaw as any[]
  for (let i = 0; i < workers.length; i++) {
    const workerRaw = workers[i]
    if (workerRaw == null || typeof workerRaw != 'object' || Array.isArray(workerRaw)) {
      continue
    }
    const worker = workerRaw as UTSJSONObject
    const personId = worker['person_id'] as number | null
    addUniqueNumber(target, personId)
  }
}

/**
 * 从会话 JSON 中提取参与人员 ID。
 * 覆盖仓内 workers、跨仓人员、晾堂各岗位、堆曲 workers；仅索引 person_id 非空的数据。
 */
export function extractPersonIdsFromSession(sessionData: UTSJSONObject): number[] {
  const ids: number[] = []

  const binsRaw = sessionData['bins']
  if (binsRaw != null) {
    const bins = binsRaw as UTSJSONObject[]
    for (let i = 0; i < bins.length; i++) {
      addSessionWorkerPersonIds(ids, bins[i]['workers'])
    }
  }

  const crossBinRaw = sessionData['cross_bin']
  if (crossBinRaw != null) {
    const crossBin = crossBinRaw as UTSJSONObject
    if (crossBin['enabled'] == true) {
      addUniqueNumber(ids, crossBin['person_id'] as number | null)
    }
  }

  const liangTangRaw = sessionData['liang_tang']
  if (liangTangRaw != null) {
    const liangTang = liangTangRaw as UTSJSONObject
    addSessionWorkerPersonIds(ids, liangTang['WHEAT_MATERIAL'])
    addSessionWorkerPersonIds(ids, liangTang['MACHINE_GUARD'])
    addSessionWorkerPersonIds(ids, liangTang['KOJI_UNLOADER'])
    addSessionWorkerPersonIds(ids, liangTang['MICRO_OPERATOR'])
  }

  const duiQuRaw = sessionData['dui_qu']
  if (duiQuRaw != null) {
    const duiQu = duiQuRaw as UTSJSONObject
    addSessionWorkerPersonIds(ids, duiQu['workers'])
  }

  return ids
}

function addUniqueBinIndexKey(target: string[], classNo: number | null, floorNo: number | null, seqNo: number | null): void {
  if (classNo == null || floorNo == null || seqNo == null) {
    return
  }
  const key = getBinIndexKey(classNo, floorNo, seqNo)
  if (target.indexOf(key) == -1) {
    target.push(key)
  }
}

/**
 * 从会话 JSON 中提取发酵仓索引 key。
 * 以 SessionData.bins[].class_no/floor_no/seq_no 为唯一来源，避免依赖展示用 bin_code 字符串解析。
 */
export function extractBinIndexKeysFromSession(sessionData: UTSJSONObject): string[] {
  const keys: string[] = []
  const binsRaw = sessionData['bins']
  if (binsRaw == null) {
    return keys
  }

  const bins = binsRaw as UTSJSONObject[]
  for (let i = 0; i < bins.length; i++) {
    addUniqueBinIndexKey(
      keys,
      bins[i]['class_no'] as number | null,
      bins[i]['floor_no'] as number | null,
      bins[i]['seq_no'] as number | null
    )
  }
  return keys
}

function addSessionToPersonBinIndexes(sessionKey: string, sessionData: UTSJSONObject): void {
  const personIds = extractPersonIdsFromSession(sessionData)
  for (let i = 0; i < personIds.length; i++) {
    addToIndex(getPersonIndexKey(personIds[i]), sessionKey)
  }

  const binIndexKeys = extractBinIndexKeysFromSession(sessionData)
  for (let i = 0; i < binIndexKeys.length; i++) {
    addToIndex(binIndexKeys[i], sessionKey)
  }
}

function removeSessionFromPersonBinIndexes(sessionKey: string, sessionData: UTSJSONObject): void {
  const personIds = extractPersonIdsFromSession(sessionData)
  for (let i = 0; i < personIds.length; i++) {
    removeFromIndex(getPersonIndexKey(personIds[i]), sessionKey)
  }

  const binIndexKeys = extractBinIndexKeysFromSession(sessionData)
  for (let i = 0; i < binIndexKeys.length; i++) {
    removeFromIndex(binIndexKeys[i], sessionKey)
  }
}

function clearPersonBinIndexes(): void {
  const info = uni.getStorageInfoSync()
  const keys = info.keys
  const personPrefix = getPersonIndexKeyPrefix()
  const binPrefix = getBinIndexKeyPrefix()

  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (key.startsWith(personPrefix) || key.startsWith(binPrefix)) {
      removeData(key)
    }
  }
}

/**
 * 重建已提交会话的 person/bin 索引。
 * 用于历史数据补索引或索引损坏自愈；草稿和缺失数据会被跳过。
 */
export function rebuildPersonBinIndexes(): void {
  clearPersonBinIndexes()

  const keys = listAllSessionKeys()
  for (let i = 0; i < keys.length; i++) {
    const parsed = parseSessionKey(keys[i])
    if (parsed == null) {
      continue
    }
    const sessionData = loadData(keys[i])
    if (sessionData != null && sessionData['status'] == 'submitted') {
      addSessionToPersonBinIndexes(keys[i], sessionData)
    }
  }
}

// ============ 会话数据操作（草稿/已提交分离） ============

/**
 * 保存草稿会话数据（写入 draft key + 全局草稿索引）
 * @param date 日期 YYYY-MM-DD
 * @param stageCode 环节代码
 * @param roundId 轮次ID
 * @param sessionData 会话数据（将强制写入 status='draft'）
 */
export function saveDraftSession(
  date: string,
  stageCode: string,
  roundId: number | null,
  sessionData: UTSJSONObject
): void {
  // 强制标记为草稿
  sessionData['status'] = 'draft'

  const key = getSessionDraftKey(date, stageCode, roundId)
  saveData(key, sessionData)

  // 更新全局草稿索引
  addToIndex(getDraftIndexKey(), key)
}

/**
 * 保存已提交会话数据（写入正式 key + 正式日期索引 + person/bin 索引）
 * 同时删除对应草稿（draft key + 全局草稿索引）
 * @param date 日期 YYYY-MM-DD
 * @param stageCode 环节代码
 * @param roundId 轮次ID
 * @param sessionData 会话数据（将强制写入 status='submitted'）
 */
export function saveSubmittedSession(
  date: string,
  stageCode: string,
  roundId: number | null,
  sessionData: UTSJSONObject
): void {
  // 强制标记为已提交
  sessionData['status'] = 'submitted'

  const key = getSessionKey(date, stageCode, roundId)
  const oldSessionData = loadData(key)
  if (oldSessionData != null) {
    removeSessionFromPersonBinIndexes(key, oldSessionData)
  }

  saveData(key, sessionData)

  // 更新正式日期索引与 person/bin 索引
  addToIndex(getDateIndexKey(date), key)
  addSessionToPersonBinIndexes(key, sessionData)

  // 删除草稿
  deleteDraftSession(date, stageCode, roundId)
}

/**
 * 加载会话数据用于编辑（draft 优先，不存在则读取 submitted）
 * @param date 日期 YYYY-MM-DD
 * @param stageCode 环节代码
 * @param roundId 轮次ID
 * @returns 会话数据（草稿或已提交），不存在时返回 null
 */
export function loadSessionForEdit(
  date: string,
  stageCode: string,
  roundId: number | null
): UTSJSONObject | null {
  const draftKey = getSessionDraftKey(date, stageCode, roundId)
  const draft = loadData(draftKey)
  if (draft != null) {
    return draft
  }
  const submittedKey = getSessionKey(date, stageCode, roundId)
  return loadData(submittedKey)
}

/**
 * 删除草稿会话数据
 * @param date 日期 YYYY-MM-DD
 * @param stageCode 环节代码
 * @param roundId 轮次ID
 */
export function deleteDraftSession(
  date: string,
  stageCode: string,
  roundId: number | null
): void {
  const key = getSessionDraftKey(date, stageCode, roundId)
  removeData(key)
  removeFromIndex(getDraftIndexKey(), key)
}

/**
 * 删除已提交会话数据
 * @param date 日期 YYYY-MM-DD
 * @param stageCode 环节代码
 * @param roundId 轮次ID
 */
export function deleteSession(
  date: string,
  stageCode: string,
  roundId: number | null
): void {
  const key = getSessionKey(date, stageCode, roundId)
  const oldSessionData = loadData(key)
  if (oldSessionData != null) {
    removeSessionFromPersonBinIndexes(key, oldSessionData)
  }
  removeData(key)
  removeFromIndex(getDateIndexKey(date), key)
}

/**
 * 获取某日期的所有已提交会话
 * @param date 日期 YYYY-MM-DD
 * @returns 会话数据列表
 */
export function getSessionsByDate(date: string): UTSJSONObject[] {
  const keys = getIndexList(getDateIndexKey(date))
  const sessions: UTSJSONObject[] = []
  for (let i = 0; i < keys.length; i++) {
    const data = loadData(keys[i])
    if (data != null) {
      sessions.push(data)
    }
  }
  return sessions
}

/**
 * 获取所有草稿会话
 * @returns 草稿会话数据列表
 */
export function getAllDraftSessions(): UTSJSONObject[] {
  const sessions: UTSJSONObject[] = []

  const keys = getIndexList(getDraftIndexKey())
  for (let i = 0; i < keys.length; i++) {
    const data = loadData(keys[i])
    if (data != null) {
      sessions.push(data)
    } else {
      // 自愈：索引存在但数据已被清理，移除幽灵条目
      removeFromIndex(getDraftIndexKey(), keys[i])
    }
  }

  return sessions
}

/**
 * 删除所有草稿会话
 */
export function deleteAllDraftSessions(): void {
  const keys = getIndexList(getDraftIndexKey())
  for (let i = 0; i < keys.length; i++) {
    removeData(keys[i])
  }
  // 清空草稿索引（直接删除索引数据）
  removeData(getDraftIndexKey())
}

/**
 * 获取某日期某环节的已提交会话
 * @param date 日期 YYYY-MM-DD
 * @param stageCode 环节代码
 * @returns 会话数据列表
 */
export function getSessionsByDateAndStage(date: string, stageCode: string): UTSJSONObject[] {
  const keys = getIndexList(getDateIndexKey(date))
  const sessions: UTSJSONObject[] = []
  for (let i = 0; i < keys.length; i++) {
    const parsed = parseSessionKey(keys[i])
    if (parsed != null && parsed.stageCode == stageCode) {
      const data = loadData(keys[i])
      if (data != null) {
        sessions.push(data)
      }
    }
  }
  return sessions
}

