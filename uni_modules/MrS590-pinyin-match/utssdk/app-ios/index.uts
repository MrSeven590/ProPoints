/**
 * MrSeven590-pinyin-match (iOS)
 *
 * Pure UTS implementation (no native dependencies).
 */

import { getInitials as _getInitials, pinyinMatch as _pinyinMatch } from '../pinyin-match.uts'

export function pinyinMatch(input: string, keyword: string): boolean {
  return _pinyinMatch(input, keyword)
}

export function getInitials(cn: string): string {
  return _getInitials(cn)
}

